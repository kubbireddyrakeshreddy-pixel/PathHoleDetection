# ============================================================
#  POTHOLE DETECTION SYSTEM — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your actual values

# Flask secret key (generate a strong random string)
SECRET_KEY=your-very-secret-flask-key-change-this

# JWT secret key (generate a strong random string)
JWT_SECRET_KEY=your-jwt-secret-key-change-this

# ---- SendGrid Email ----------------------------------------
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourapp.com
SENDGRID_FROM_NAME=RoadSafe Portal

# ---- Database ----------------------------------------------
# SQLite (default, no config needed)
DATABASE_URL=sqlite:///pothole_system.db

# ---- Model -------------------------------------------------
MODEL_PATH=best.pt

# ---- File Upload -------------------------------------------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216   # 16 MB

# ---- Confidence Threshold ----------------------------------
CONFIDENCE_THRESHOLD=0.40
